rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Specific match for application data collections and active sessions
    match /appData/{document=**} {
      allow read, write: if true;
    }
    match /activeSessions/{deviceId} {
      allow read, write: if true;
    }
    // Default fallback rule for other paths
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
